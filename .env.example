# Copy to .env.local, choose your own values, and restart the server.
# At least 12 characters. Never prefix secrets with NEXT_PUBLIC_.
VIVID_ADMIN_PASSWORD=
# At least 32 random characters. Changing either secret invalidates sessions.
VIVID_SESSION_SECRET=
# Required on Vercel: connect ONE PRIVATE Vercel Blob store to this project.
# Vercel normally supplies BLOB_STORE_ID and runtime OIDC authentication.
# BLOB_STORE_ID=
# This store holds both CMS content (including drafts) and uploaded media.
# Optional legacy authentication instead of OIDC; never expose this token.
# BLOB_READ_WRITE_TOKEN=
# Optional absolute directory on a persistent writable volume. Default: .data
# VIVID_DATA_DIR=
# Optional for local development with saved .data content, even with pulled Blob credentials.
# Ignored on Vercel, where the app always requires shared Blob storage.
# VIVID_STORAGE_MODE=local
# Optional exact public origin when running behind a reverse proxy.
# VIVID_SITE_ORIGIN=https://example.com
