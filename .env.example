# Copy to .env.local, choose your own values, and restart the server.
# At least 12 characters. Never prefix secrets with NEXT_PUBLIC_.
VIVID_ADMIN_PASSWORD=
# At least 32 random characters. Changing either secret invalidates sessions.
VIVID_SESSION_SECRET=
# Required for Cloudinary storage, including on Vercel. Find these in your
# Cloudinary console. Keep the API secret server-only; no NEXT_PUBLIC_ prefix.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively use CLOUDINARY_URL instead of the three variables above:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Optional namespace for this site's media and private content. Default: vivid
# Use a different namespace for previews that should not edit production.
# VIVID_CLOUDINARY_FOLDER=vivid
# Optional absolute directory on a persistent writable volume. Default: .data
# VIVID_DATA_DIR=
# Optional for local development with saved .data content, even with Cloudinary configured.
# Ignored on Vercel, where the app always requires Cloudinary storage.
# VIVID_STORAGE_MODE=local
# Optional exact public origin when running behind a reverse proxy.
# VIVID_SITE_ORIGIN=https://example.com
